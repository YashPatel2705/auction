# ─── Supabase Credentials ───────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (Vercel / `vercel dev`). Same project URL as above; needed for /api because
# VITE_* is not always exposed to serverless handlers.
SUPABASE_URL=https://your-project-id.supabase.co

# Server-only. Required for POST /api/registration-photo. Never use VITE_* for this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin Password ──────────────────────────────────────────────
# Simple password gate for the admin (auction) panel
VITE_ADMIN_PASSWORD=auction2024

# ─── YDS Payment SDK ──────────────────────────────────────────────
VITE_YDS_PAYMENT_SDK_URL=https://your-yds-payment-sdk-url.com
VITE_YDS_PAYMENT_SDK_FORM_ID=your-yds-payment-sdk-form-id
